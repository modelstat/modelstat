{
  "name": "@modelstat/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "modelstat Chrome extension — token usage tracking for ChatGPT, Claude, Gemini, Grok web UIs",
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && vite",
    "build": "node scripts/prepare-assets.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "zip": "cd dist && zip -r ../modelstat-extension.zip . && cd .. && echo 'wrote modelstat-extension.zip'",
    "clean": "rm -rf dist .turbo *.tsbuildinfo public/assets/tiktoken public/tiktoken_bg.wasm modelstat-extension.zip"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.3.0",
    "@mlc-ai/web-llm": "^0.2.78",
    "@modelstat/adapters-protocol": "workspace:*",
    "@modelstat/daemon-core": "workspace:*",
    "@modelstat/core": "workspace:*",
    "@noble/hashes": "^1.7.0",
    "dexie": "^4.0.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tiktoken": "^1.0.17",
    "ulid": "^2.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@tailwindcss/vite": "^4.0.0-beta.8",
    "@types/chrome": "^0.0.287",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0-beta.8",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
