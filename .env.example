# ─────────────────────────────────────────────────────────────
# modelstat daemon — local dev env. Copy to .env if needed.
# ─────────────────────────────────────────────────────────────
# All vars are optional. The daemon ships sensible defaults
# and will pair itself against modelstat.ai out of the box.

# ── Agent (Node CLI) ─────────────────────────────────────────

# Point the agent at a custom endpoint (default: modelstat.ai).
# DAEMON_API_URL=https://modelstat.ai

# Log verbosity: error | warn | info | debug
AGENT_LOG_LEVEL=info

# Extra directories to scan for tool logs, comma-separated.
# Useful if your Claude/Codex/Cursor data lives on a non-default
# drive (e.g. an external SSD for work profiles).
# AGENT_EXTRA_CLAUDE_DIRS=/Volumes/Work/.claude
# AGENT_EXTRA_CODEX_DIRS=
# AGENT_EXTRA_CURSOR_DIRS=

# ── Summariser mode ──────────────────────────────────────────
# Where each session gets summarised. Chosen at install (`modelstat
# connect`, Cloud pre-selected) and changeable later with
# `modelstat mode <cloud|local|self-hosted>`. Redaction (regex floor +
# on-device NER/PII) runs on YOUR machine in EVERY mode — only the
# summarisation LOCATION differs:
#   cloud       — default; no local model. Cleaned, redacted turns are
#                 uploaded to /v1/ingest/raw and summarised server-side.
#   local       — a bundled ~2.7 GB LLM summarises on this machine (the
#                 only mode that downloads the model). Abstracts uploaded.
#   self-hosted — your org's OpenAI-compatible endpoint summarises the
#                 cleaned excerpts (set the URL/model below). Abstracts uploaded.
#
# Override the persisted install choice (handy for CI / scripted installs):
# MODELSTAT_SUMMARIZER_MODE=cloud

# ── Self-hosted endpoint ─────────────────────────────────────
# Used in self-hosted mode. Set at install (`modelstat mode self-hosted
# --url <URL> --model <ID>`) or via these env vars (they override the
# persisted values when BOTH url and model are present).
#
# PRIVACY: self-hosted is an EXPLICIT egress — sampled session excerpts
# and script bodies are sent to the endpoint below, but only AFTER an
# on-device scrub (deterministic regex floor + NER/PII pass) runs over
# them first. Embeddings + the PII redactor stay local. The daemon prints
# a one-time warning at startup when this is on.
# MODELSTAT_LLM_BASE_URL=https://api.openai.com/v1
# MODELSTAT_LLM_MODEL=gpt-4o-mini
# MODELSTAT_LLM_API_KEY=sk-...
# Per-request timeout in ms (default 60000).
# MODELSTAT_LLM_TIMEOUT_MS=60000
