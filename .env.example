# ─────────────────────────────────────────────────────────────
# modelstat daemon — local dev env. Copy to .env if needed.
# ─────────────────────────────────────────────────────────────
# All vars are optional. The daemon ships sensible defaults
# and will pair itself against modelstat.ai out of the box.

# ── Agent (Node CLI) ─────────────────────────────────────────

# Point the agent at a custom endpoint (default: modelstat.ai).
# DAEMON_API_URL=https://modelstat.ai

# Log verbosity: error | warn | info | debug
AGENT_LOG_LEVEL=info

# Extra directories to scan for tool logs, comma-separated.
# Useful if your Claude/Codex/Cursor data lives on a non-default
# drive (e.g. an external SSD for work profiles).
# AGENT_EXTRA_CLAUDE_DIRS=/Volumes/Work/.claude
# AGENT_EXTRA_CODEX_DIRS=
# AGENT_EXTRA_CURSOR_DIRS=

# ── Summariser runtime ───────────────────────────────────────
# By default the daemon runs a bundled ~2.7 GB LLM ON YOUR MACHINE.
# On a sandbox / thin laptop / CI where that isn't viable, point the
# summariser at any OpenAI-compatible endpoint instead.
#
# PRIVACY: a remote summariser is an EXPLICIT egress — sampled session
# excerpts and script bodies are sent to the endpoint below, but only
# AFTER an on-device scrub (deterministic regex floor + NER/PII pass)
# runs over them first. Embeddings + the PII redactor stay local.
# The daemon prints a one-time warning at startup when this is on.
# MODELSTAT_LLM_PROVIDER=openai
# MODELSTAT_LLM_BASE_URL=https://api.openai.com/v1
# MODELSTAT_LLM_MODEL=gpt-4o-mini
# MODELSTAT_LLM_API_KEY=sk-...
# Per-request timeout in ms (default 60000).
# MODELSTAT_LLM_TIMEOUT_MS=60000
