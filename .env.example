# ─────────────────────────────────────────────────────────────
# modelstat companion — local dev env. Copy to .env if needed.
# ─────────────────────────────────────────────────────────────
# All vars are optional. The companion ships sensible defaults
# and will pair itself against modelstat.ai out of the box.

# ── Agent (Node CLI) ─────────────────────────────────────────

# Point the agent at a custom endpoint (default: modelstat.ai).
# AGENT_API_URL=https://modelstat.ai

# Log verbosity: error | warn | info | debug
AGENT_LOG_LEVEL=info

# Extra directories to scan for tool logs, comma-separated.
# Useful if your Claude/Codex/Cursor data lives on a non-default
# drive (e.g. an external SSD for work profiles).
# AGENT_EXTRA_CLAUDE_DIRS=/Volumes/Work/.claude
# AGENT_EXTRA_CODEX_DIRS=
# AGENT_EXTRA_CURSOR_DIRS=
