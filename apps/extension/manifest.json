{
  "manifest_version": 3,
  "name": "modelstat — See what your AI chats cost",
  "version": "0.1.2",
  "description": "Live token & cost counter for ChatGPT, Claude, Gemini, and Grok. See exactly what every chat costs, in real time. Local-first.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "public/icon-16.png",
    "32": "public/icon-32.png",
    "48": "public/icon-48.png",
    "128": "public/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "modelstat",
    "default_icon": {
      "16": "public/icon-16.png",
      "32": "public/icon-32.png"
    }
  },
  "options_page": "src/options/index.html",
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "offscreen",
    "tabs"
  ],
  "host_permissions": [
    "https://modelstat.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://x.com/i/grok/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://x.com/i/grok/*"
      ],
      "js": ["src/content/index.ts"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://x.com/i/grok/*"
      ],
      "js": ["src/content/main-world.ts"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/main-world.ts",
        "src/offscreen/index.html",
        "assets/*",
        "public/*",
        "tiktoken_bg.wasm"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://x.com/*"
      ]
    }
  ]
}
