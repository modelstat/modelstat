{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*", "tests/**/*", "vite.config.ts"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["chrome", "vite/client"],
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
