{
  "protocol_version": 1,
  "provider": "gemini_web",
  "vendor": "google",
  "adapter_version": 1,
  "match": ["https://gemini.google.com/*"],
  "default_model": "gemini-2.0-flash",
  "extractors": {
    "conversation_id": [
      { "kind": "url.regexGroup", "pattern": "/app/([A-Za-z0-9_-]+)", "group": 1 }
    ],
    "model": [
      {
        "kind": "dom.selector.text",
        "selector": "[data-test-id='bard-mode-menu-button'], bard-mode-switcher button"
      }
    ],
    "messages": [
      {
        "kind": "dom.observe",
        "selector": "message-content",
        "idAttr": "id",
        "roleAttr": "data-from",
        "roleDefault": "assistant",
        "textSelector": "div.markdown, .response-content"
      },
      {
        "kind": "dom.observe",
        "selector": "user-query-content",
        "idAttr": "id",
        "roleDefault": "user",
        "textSelector": ".query-text"
      }
    ]
  },
  "tokenizer": {
    "default": "sentencepiece/gemma",
    "byModel": {
      "gemini-*": "sentencepiece/gemma"
    }
  },
  "invariants": [
    { "kind": "dom.minCount", "selector": "main, chat-app", "min": 1 }
  ]
}
