{
  "name": "@modelstat/mcp",
  "version": "0.3.0",
  "description": "MCP server for modelstat — ask any MCP-compatible AI tool about your token spend.",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "modelstat",
    "ai",
    "observability",
    "token-tracking"
  ],
  "homepage": "https://mcp.modelstat.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modelstat/modelstat.git",
    "directory": "packages/mcp"
  },
  "bugs": "https://github.com/modelstat/modelstat/issues",
  "license": "MIT",
  "type": "module",
  "bin": {
    "modelstat-mcp": "./dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --out-dir dist --clean --no-splitting --minify && node scripts/build-view.mjs",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit && tsc -p src/view/tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "esbuild": "^0.24.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "zod": "3.25.76"
  }
}
