{
  "name": "modelstat",
  "version": "0.0.0",
  "private": true,
  "description": "Daemon source for modelstat — the Node CLI, macOS tray, and shared packages that produce the binaries published to npm and Homebrew. Build from source if you prefer to audit what runs on your machine.",
  "homepage": "https://modelstat.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/modelstat/modelstat.git"
  },
  "bugs": "https://github.com/modelstat/modelstat/issues",
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "ai-cost-tracking",
    "llm-observability",
    "token-tracking",
    "claude-code",
    "cursor",
    "codex",
    "aider",
    "copilot",
    "cline",
    "continue",
    "modelstat",
    "mcp",
    "mcp-server",
    "finops"
  ],
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=10.7.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "mcp:build": "pnpm --filter @modelstat/mcp build",
    "mcp:dev": "pnpm --filter @modelstat/mcp dev",
    "tray-mac:build": "cd apps/tray-mac && swift build -c release"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@biomejs/biome",
      "@tailwindcss/oxide"
    ]
  }
}
