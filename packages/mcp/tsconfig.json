{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  // src/view is the browser MCP-UI widget (DOM lib + Bundler resolution); it has
  // its own tsconfig (src/view/tsconfig.json) and is bundled by
  // scripts/build-view.mjs, not tsup. Excluded from this Node typecheck.
  "exclude": ["src/view"]
}
